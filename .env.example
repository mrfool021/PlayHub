# Copy this file to ".env" in the project root and replace every "change_me" value.
# NEVER commit the real .env file (it is listed in .gitignore).
# Generate secrets with:  openssl rand -hex 32

# ---- Server: port ------------------------------------------------------------
PORT=3000

# ---- Server: MySQL connection (mysql2/promise pool) ----------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=change_me_mysql_user
DB_PASSWORD=change_me_mysql_password
DB_NAME=playhub

# ---- Server: security ------------------------------------------------------------
# Signs login tokens. REQUIRED, at least 32 random characters
JWT_SECRET=change_me_at_least_32_random_characters
JWT_EXPIRES_IN=7d
# Salt for the anonymised voter hashes. REQUIRED
VOTER_SALT=change_me_salt
# Browser origins allowed to call the API (comma separated)
CORS_ORIGIN=http://localhost:5173
ENFORCE_ONE_VOTE=true

# ---- Server: optional limits ------------------------------------------------------
POLL_IMAGE_MAX_BYTES=1572864
AVATAR_MAX_BYTES=262144
RATE_LIMIT_MAX=600

# ---- Client (Vite). Only variables starting with VITE_ reach the browser ----------
# Base URL of the API used by the shared axios instance (client/src/api/axios.js)
VITE_API_URL=http://localhost:3000/api
